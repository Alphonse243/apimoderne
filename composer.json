{
    "name": "api/blobal",
    "description": "api php avec ORM eloquant,faker,carbon,illuminate,phpmailer",
    "require": {
        "php": "^8.0",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "fakerphp/faker": "^1.23",
        "nesbot/carbon": "^2.71",
        "jenssegers/blade": "^2.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "minimum-stability": "stable"
}
