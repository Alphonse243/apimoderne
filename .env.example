# Example .env for apimoderne

# Choose driver: mysql or sqlite
DB_DRIVER=sqlite

# SQLite example (path relative to project root)
DB_DATABASE=database/database.sqlite

# MySQL example (uncomment if you use mysql)
#DB_DRIVER=mysql
#DB_HOST=127.0.0.1
#DB_DATABASE=api-global
#DB_USERNAME=root
#DB_PASSWORD=

# Other optional config (mail, app keys, etc.)
#APP_ENV=local
#APP_DEBUG=true
